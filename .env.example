# Copie para .env e preencha. O .env nunca vai para o git.

# Motor de transcrição padrão: nova3 (Deepgram, nuvem) ou whisper (local)
TRANSCRIPTION_ENGINE=nova3

# Deepgram (necessário só para o Nova-3): https://console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_LANGUAGE=multi

# Whisper local (veja o README para baixar o servidor e o modelo)
# WHISPER_LANGUAGE=pt
# WHISPER_VAD_THRESHOLD=0.01

# Notas com IA: sem ANTHROPIC_API_KEY, usa o Ollama local
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_URL=http://127.0.0.1:11434
# ANTHROPIC_API_KEY=

# Pasta das reuniões (padrão: Documentos\Granolinha\reunioes)
# GRANOLINHA_DATA_DIR=
